# Copy to .env and fill in. NEVER commit the real .env.

# Database password (any long random string)
POSTGRES_PASSWORD=

# Signs login tokens.   python -c "import secrets; print(secrets.token_urlsafe(48))"
SKINSENSE_SECRET_KEY=

# Encrypts stored photos.  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP SEPARATELY: if it is lost, every stored photo is unrecoverable.
SKINSENSE_IMAGE_KEY=

# Public address of the site (must match what users type in the browser; used for CORS)
SKINSENSE_ORIGINS=http://localhost:8000

# Only for the https profile
DOMAIN=
APP_PORT=8000
